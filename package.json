{
  "name": "signalk-alert-center",
  "version": "0.1.0",
  "description": "Durable offline-first Signal K alert delivery plugin",
  "author": "Sebastian Karasek",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arodus/signalk-alert-center.git"
  },
  "homepage": "https://github.com/arodus/signalk-alert-center#readme",
  "bugs": {
    "url": "https://github.com/arodus/signalk-alert-center/issues"
  },
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "files": [
    "dist",
    "public",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-plugin-configurator",
    "signalk-webapp",
    "signalk-category-notifications",
    "signalk",
    "notifications"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "clean": "node scripts/clean-dist.mjs",
    "build": "npm run clean && tsc -p tsconfig.json && npm run build:panel",
    "build:panel": "webpack --config webpack.config.cjs --stats errors-only",
    "demo": "docker compose -f docker-compose.live.yml -f docker-compose.demo.yml up --build -d",
    "test": "vitest run",
    "test:integration": "RUN_DOCKER_INTEGRATION=1 vitest run test/integration.test.ts",
    "test:acceptance": "docker compose -f docker-compose.acceptance.yml up --build --abort-on-container-exit --exit-code-from acceptance",
    "test:browser": "node test/browser/run.mjs",
    "test:browser:only": "playwright test",
    "test:restart": "node test/integration/restart.mjs",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "package:check": "node scripts/verify-package.mjs",
    "package:smoke": "node scripts/smoke-package.mjs",
    "release:check": "npm run format:check && npm run typecheck && npm test && npm run build && npm run package:check && npm run package:smoke",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@babel/core": "^7.28.4",
    "@babel/preset-react": "^7.27.1",
    "@playwright/test": "^1.55.0",
    "@signalk/server-api": "^2.31.1",
    "@types/node": "^22.10.1",
    "babel-loader": "^10.0.0",
    "prettier": "^3.9.6",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1"
  },
  "signalKPlugin": {
    "id": "signalk-alert-center"
  },
  "signalk": {
    "appIcon": "./icon-192.png",
    "displayName": "Signal K Alert Center",
    "recommends": [
      "signalk-piper",
      "signalk-wyoming"
    ]
  },
  "signalk-plugin-enabled-by-default": false
}
